# Serverda shu faylni .env deb nusxalab, qiymatlarini to'ldiring.

# Yangi kalit: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=almashtiring-bu-kalitni

DEBUG=False

# Domen yoki server IP (vergul bilan)
ALLOWED_HOSTS=ombor.thesofmebel.uz,127.0.0.1,localhost

# Admin panelga domen orqali kirish uchun
CSRF_TRUSTED_ORIGINS=https://ombor.thesofmebel.uz,http://ombor.thesofmebel.uz

# React frontend manzili
CORS_ALLOWED_ORIGINS=https://ombor.thesofmebel.uz,https://warehouse-frontend-iota.vercel.app,http://localhost:5173

# Docker konteyneri shu portda turadi (band bo'lsa boshqasini yozing)
WEB_PORT=8089

# HSTS muddati soniyalarda (0 = o'chirilgan; default 30 kun, DEBUG=False bo'lganda)
# SECURE_HSTS_SECONDS=2592000

# Demo foydalanuvchilar paroli (seed_users/seed_demo); bermasangiz: Ombor2026!
# DEMO_PASSWORD=kuchli-demo-parol

# Serverda Caddy bo'lsa — uning docker tarmog'i (skript o'zi to'ldiradi)
# CADDY_NETWORK=edu_platform_default

# Docker uchun: baza volume ichida turadi (docker'siz variantda bu qatorni o'chiring)
SQLITE_PATH=/app/data/db.sqlite3

# Ixtiyoriy: konteyner birinchi ishga tushganda admin ochish
# DJANGO_SUPERUSER_USERNAME=admin
# DJANGO_SUPERUSER_EMAIL=admin@thesofmebel.uz
# DJANGO_SUPERUSER_PASSWORD=kuchli-parol

# 15-§A: shartnoma .docx'ini Collabora Online'da tahrirlash (ixtiyoriy —
# faqat "docker compose --profile with-collabora" yoqilsa kerak)
# Collabora'ning o'zi qayerda turibdi (front shu yerdan iframe ochadi)
# COLLABORA_URL=https://collabora.ombor.thesofmebel.uz
# Collabora BIZGA (WOPI host) qaytib ulanadigan tashqi manzil
# WOPI_PUBLIC_URL=https://ombor.thesofmebel.uz
# COLLABORA_ADMIN_USER=admin
# COLLABORA_ADMIN_PASSWORD=kuchli-parol
