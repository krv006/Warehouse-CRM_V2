# Serverda shu faylni .env deb nusxalab, qiymatlarini to'ldiring.

# Yangi kalit: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=almashtiring-bu-kalitni

DEBUG=False

# Domen yoki server IP (vergul bilan)
ALLOWED_HOSTS=ombor.thesofmebel.uz,127.0.0.1,localhost

# Admin panelga domen orqali kirish uchun
CSRF_TRUSTED_ORIGINS=https://ombor.thesofmebel.uz,http://ombor.thesofmebel.uz

# React frontend manzili
CORS_ALLOWED_ORIGINS=https://ombor.thesofmebel.uz,http://localhost:5173

# Docker konteyneri shu portda turadi (band bo'lsa boshqasini yozing)
WEB_PORT=8089

# Docker uchun: baza volume ichida turadi (docker'siz variantda bu qatorni o'chiring)
SQLITE_PATH=/app/data/db.sqlite3

# Ixtiyoriy: konteyner birinchi ishga tushganda admin ochish
# DJANGO_SUPERUSER_USERNAME=admin
# DJANGO_SUPERUSER_EMAIL=admin@thesofmebel.uz
# DJANGO_SUPERUSER_PASSWORD=kuchli-parol
